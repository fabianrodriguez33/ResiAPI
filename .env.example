DB_NAME=resiup
DB_USER=resiup
DB_PASSWORD=
JWT_SECRET=
QR_SECRET=
# Administrador inicial (solo se crea si no existe ninguno). Clave minima 8 caracteres.
ADMIN_USUARIO=
ADMIN_CLAVE=
JWT_EXPIRACION_SEGUNDOS=604800

# Correo de verificación (opcional). Con Gmail: smtp.gmail.com, puerto 587 y una "contraseña de aplicación".
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=tu-cuenta@gmail.com
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# Correos a los que se puede enviar (coma). Por defecto solo el de pruebas; vacío = cualquiera.
# CORREO_PERMITIDOS=61050923@upeu.edu.pe

# SMS con Twilio (opcional). Sin estas variables el SMS solo se escribe en el registro del servidor.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_DESDE=+1...
# Números a los que se puede enviar (coma, con o sin +51); vacío = cualquiera.
# SMS_PERMITIDOS=

# Push con Firebase Cloud Messaging (opcional): ruta al JSON de la cuenta de servicio del proyecto Firebase.
# FCM_CREDENCIALES=C:/ruta/firebase-servicio.json
